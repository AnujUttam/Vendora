# ==============================================================================
# Vendora Multi-Vendor E-Commerce Marketplace – Environment Configuration
# ==============================================================================
# Copy this file to '.env' in the backend directory:
#   cp .env.example .env
#
# NOTE: Vendora is architected with graceful development fallbacks.
# If external cloud services (Redis, Elasticsearch, AWS S3, Razorpay) are not
# configured or unreachable, the application automatically uses resilient local
# fallbacks (In-Memory cache, MongoDB regex search, local uploads, simulated test mode).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database (MongoDB Atlas or Local MongoDB)
# ------------------------------------------------------------------------------
# Standard Local MongoDB:
# MONGO_URI=mongodb://localhost:27017/vendora

# MongoDB Atlas (SRV format):
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/vendora?retryWrites=true&w=majority

# MongoDB Atlas (Standard Seed-List format - alternative if SRV DNS is blocked):
# MONGO_URI=mongodb://<username>:<password>@cluster0-shard-00-00.mongodb.net:27017/vendora?ssl=true&replicaSet=atlas-shard-0&authSource=admin

# Optional: Custom DNS servers for Node.js c-ares resolver (useful on Windows mobile hotspots)
DNS_SERVERS=8.8.8.8,1.1.1.1

# ------------------------------------------------------------------------------
# 3. JSON Web Token (JWT) Security
# ------------------------------------------------------------------------------
JWT_SECRET=super_secure_vendora_jwt_secret_key_change_in_production_2026
JWT_EXPIRE=7d

# ------------------------------------------------------------------------------
# 4. Redis Cache Configuration
# ------------------------------------------------------------------------------
# Redis connection URL for cart caching and performance optimization
# Fallback: In-memory JavaScript Map cache when Redis is offline
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 5. Elasticsearch Configuration
# ------------------------------------------------------------------------------
# Endpoint for full-text search and catalog indexing
# Fallback: MongoDB compound text indexes & regex search when ES is offline
ELASTICSEARCH_NODE=http://localhost:9200

# ------------------------------------------------------------------------------
# 6. AWS S3 Storage Configuration
# ------------------------------------------------------------------------------
# Credentials for product image uploads to Amazon S3
# Fallback: Local disk storage in 'backend/uploads/' served via Express static
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=vendora-marketplace-uploads

# ------------------------------------------------------------------------------
# 7. Razorpay Payment Gateway Configuration
# ------------------------------------------------------------------------------
# Test mode API credentials obtained from Razorpay Dashboard (https://dashboard.razorpay.com)
# Fallback: Simulated test mode signatures (order_*, test_signature)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_key

# ------------------------------------------------------------------------------
# 8. Initial Admin Seeding Credentials & Platform Defaults
# ------------------------------------------------------------------------------
# Default credentials seeded on initial database bootstrap
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@vendora.com
ADMIN_PASSWORD=AdminPassword123!
DEFAULT_COMMISSION_RATE=10
